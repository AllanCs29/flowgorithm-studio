<?xml version="1.0" encoding="UTF-8"?>
<flowgorithm fileversion="4.2">
  <attributes>
    <attribute name="name" value="Área de un círculo" />
    <attribute name="about" value="Ejercicio introductorio: declarar, leer, calcular y mostrar" />
  </attributes>
  <function name="Main" type="None" variable="">
    <parameters />
    <body>
      <declare name="area, radius" type="Real" array="False" size="" />
      <input variable="radius" />
      <assign variable="area" expression="pi * radius ^ 2" />
      <output expression="&quot;The area is &quot; &amp; area" newline="True" />
    </body>
  </function>
</flowgorithm>
